# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. Add the current IP to Atlas network access.
# An empty database is bootstrapped with site settings and six projects by
# `npm run build` (or manually with `npm run seed:initial`).
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# Optional. Defaults to the database named in the URI.
MONGODB_DB=shivnarayan-portfolio
# Optional. Set to true to fail `npm run build` when the initial database seed
# cannot connect. By default the build warns and uses static fallback content.
SEED_STRICT=

# ─── Auth ────────────────────────────────────────────────────────────────────
# A long random string. Generate one with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-at-least-32-random-characters
# JWT_SECRET is also accepted as a fallback for backwards compatibility.

# Used by `npm run seed` and the build-time admin seed. Set both to enable
# automatic admin creation during `npm run build`; omit both to skip it.
ADMIN_NAME=ShivNarayan Sah
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://shivnarayan.com.np

# ─── Cloudinary (image uploads) ──────────────────────────────────────────────
# Without these, image uploads are disabled but pasted image URLs still work.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=shivnarayan-portfolio

# ─── Email (optional, Resend) ────────────────────────────────────────────────
# Contact messages are always stored in MongoDB. Email is best-effort.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>
CONTACT_TO_EMAIL=shivnarayan2072@gmail.com

# ─── External revalidation (optional) ────────────────────────────────────────
# Protect /api/revalidate?tag=projects with this secret.
REVALIDATE_SECRET=replace-with-another-random-string
